ENV=DEV
BLIX_INTERNAL_TOKEN=blix-development

BLIX_CLI_UID=0
BLIX_CLI_GID=0
BLIX_CLI_HOME=/home/blix
BLIX_URL=http://host.docker.internal:10310
BLIX_CREDENTIALS_DIR=/tmp/blix-cli-credentials

KERBECS_CONFIG=/etc/kerbecs/kerbecs.yaml
WEB_RUNWAY_URL=http://runway:9999
WEB_KNOWLEDGE_URL=http://knowledge:9988
RUNWAY_PORT=9999
KNOWLEDGE_PORT=9988
INGESTION_PORT=9977
INGESTION_DOCUMENT_CONCURRENCY=2
INGESTION_PAGE_CONCURRENCY=4
INGESTION_GLOBAL_PAGE_CONCURRENCY=8
INGESTION_POLL_INTERVAL=2s
RUNWAY_URL=http://runway:9999
KNOWLEDGE_URL=http://knowledge:9988
SANDBOX_URL=http://sandbox-worker:8080

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=blix

MQTT_URL=mqtt://nanomq:1883
MQTT_CLIENT_ID=blix-runway
MQTT_HOST=nanomq
MQTT_PORT=1883
MQTT_ATTEMPT_READY_TOPIC=blix/v1/attempts/ready
MQTT_RUN_EVENT_TOPIC_PREFIX=blix/v1/runs

EXECUTION_LEASE_DURATION=30s
EXECUTION_LEASE_SWEEP_INTERVAL=5s
WORKER_HEARTBEAT_INTERVAL=5s
WORKER_OFFLINE_AFTER=15s
AGENT_WORKER_CONCURRENCY=4
AGENT_WORKER_INTERACTIVE_CONCURRENCY=1
LEAD_HISTORY_MAX_CHARS=80000
DOCUMENT_VISION_CONCURRENCY=4

SENTINEL_URL=https://sso.gauchoracing.com
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_SCOPES="user:read groups:read"
SENTINEL_SERVICE_ACCOUNT_TOKEN=

DEPOT_URL=https://depot.gauchoracing.com/api
DEPOT_BUCKET=gaucho-racing-development
DEPOT_PUBLIC_BUCKET=gaucho-racing-development
DOCUMENT_STORAGE_PATH=/data/documents

WIKI_REPOSITORY_URL=https://github.com/gaucho-racing/blixwiki.git
WIKI_REPOSITORY_BRANCH=main
WIKI_REPOSITORY_PATH=/data/wiki
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

LLM_GATEWAY_ENDPOINT=
LLM_GATEWAY_API_KEY=
LLM_LEAD_MODEL=gpt-6-astra
LLM_LEAD_REASONING_EFFORT=medium
LLM_RESEARCH_MODEL=gpt-6-astra
LLM_RESEARCH_REASONING_EFFORT=high
LLM_CURATOR_MODEL=gpt-6-astra
LLM_CURATOR_REASONING_EFFORT=medium
LLM_DOCUMENT_QA_MODEL=gpt-5.6-luna
LLM_DOCUMENT_QA_REASONING_EFFORT=low
LLM_DOCUMENT_VISION_MODEL=gpt-5.6-luna
LLM_DOCUMENT_VISION_REASONING_EFFORT=low

WORKBENCH_URL=https://workbench.gauchoracing.com/api
WORKBENCH_CLIENT_ID=rmgwGSAfAx9Q

TAVILY_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_REVISION=1
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SEND_DIMENSIONS=false

RERANK_ENDPOINT=
RERANK_API_KEY=
RERANK_MODEL=

DISCORD_PORT=9966
DISCORD_POLL_INTERVAL=2s
BLIX_PUBLIC_URL=http://localhost:10310
DATABASE_SSL_MODE=disable

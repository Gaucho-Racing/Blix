ENV=DEV
BLIX_INTERNAL_TOKEN=blix-development

BLIX_CLI_UID=0
BLIX_CLI_GID=0
BLIX_CLI_HOME=/home/blix
BLIX_URL=http://host.docker.internal:10310
BLIX_CREDENTIALS_DIR=/tmp/blix-cli-credentials

KERBECS_CONFIG=/etc/kerbecs/kerbecs.yaml
WEB_RUNWAY_URL=http://runway:9999
WEB_KNOWLEDGE_URL=http://knowledge:9988
RUNWAY_PORT=9999
KNOWLEDGE_PORT=9988
RUNWAY_URL=http://runway:9999
KNOWLEDGE_URL=http://knowledge:9988

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=blix

MQTT_URL=mqtt://nanomq:1883
MQTT_CLIENT_ID=blix-runway
MQTT_HOST=nanomq
MQTT_PORT=1883
MQTT_ATTEMPT_READY_TOPIC=blix/v1/attempts/ready
MQTT_CONVERSATION_EVENT_TOPIC_PREFIX=blix/v1/conversations

EXECUTION_LEASE_DURATION=30s
EXECUTION_LEASE_SWEEP_INTERVAL=5s
WORKER_HEARTBEAT_INTERVAL=5s
WORKER_OFFLINE_AFTER=15s
AGENT_WORKER_CONCURRENCY=4
AGENT_WORKER_INTERACTIVE_CONCURRENCY=1
LEAD_HISTORY_MAX_CHARS=80000

SENTINEL_URL=https://sso.gauchoracing.com
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_SCOPES="user:read groups:read"
SENTINEL_SERVICE_ACCOUNT_TOKEN=

DEPOT_URL=https://depot.gauchoracing.com/api
DEPOT_BUCKET=gaucho-racing-development
DOCUMENT_STORAGE_PATH=/data/documents

WIKI_REPOSITORY_URL=https://github.com/gaucho-racing/blixwiki.git
WIKI_REPOSITORY_BRANCH=main
WIKI_REPOSITORY_PATH=/data/wiki
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

LLM_GATEWAY_ENDPOINT=
LLM_GATEWAY_API_KEY=
LLM_MODEL=gpt-6-astra
LLM_REASONING_EFFORT=
LLM_LEAD_MODEL=
LLM_LEAD_REASONING_EFFORT=
LLM_RESEARCH_MODEL=
LLM_RESEARCH_REASONING_EFFORT=
LLM_CURATOR_MODEL=
LLM_CURATOR_REASONING_EFFORT=

TAVILY_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

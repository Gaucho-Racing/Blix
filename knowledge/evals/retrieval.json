      "requires_image": false,
      "expect_abstention": false,
      "evidence_groups": [
        {
          "id": "sql-alignment-cost",
          "claim": "Aligning mismatched timestamps in SQL is expensive and error prone.",
          "alternatives": [
            {
              "spans": [
                {
                  "kind": "text",
                  "document": "gr25",
